# ============================================================
# sofortangebot.app — Environment Variables
# Kopiere diese Datei nach .env.local und fülle die Werte aus
# NIEMALS .env.local in Git committen!
# ============================================================

# development | staging | production | ci
NEXT_PUBLIC_APP_ENV=development

# ── Supabase ─────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── OpenAI ───────────────────────────────────────────────────
# https://platform.openai.com/api-keys
# Verwendet für: Angebot-Generierung aus Sprache, PDF-Analyse
OPENAI_API_KEY=sk-...

# ── Resend (E-Mail) ───────────────────────────────────────────
# https://resend.com/api-keys
# Domain sofortangebot.app muss verifiziert sein
RESEND_API_KEY=re_...

# ── Stripe ───────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Dashboard → Products → Dein Pro-Plan → Price ID
STRIPE_PRO_PRICE_ID=price_...

# ── App-URL ───────────────────────────────────────────────────
# Lokal: http://localhost:3000
# Produktion: https://sofortangebot.app
NEXT_PUBLIC_APP_URL=https://sofortangebot.app

# Optionaler Schutz gegen versehentlich vertauschte Supabase-Projekte.
# In Staging und Produktion auf die echte Produktions-Project-Ref setzen.
PRODUCTION_SUPABASE_PROJECT_REF=yqlledouhfovytifeekd

# ── Cron-Sicherheit ───────────────────────────────────────────
# Beliebiger langer zufälliger String (z.B. openssl rand -hex 32)
# Muss auch in Vercel Cron-Konfiguration als Bearer-Token eingetragen sein
CRON_SECRET=dein_geheimer_cron_token_hier

# Interne Monitoring-Endpunkte und Supabase-Trigger
# Muss gesetzt sein; ohne Wert lehnen die Endpunkte interne Secret-Aufrufe ab.
ALERT_SECRET=dein_geheimes_monitoring_token_hier

# E-Mail-Adresse mit Zugriff auf den Admin-Bereich
ADMIN_EMAIL=admin@example.com
# Empfänger für Monitoring-Warnungen (optional, fällt sonst auf ADMIN_EMAIL zurück)
ADMIN_ALERT_EMAIL=admin@example.com

# ── Feature Flags ─────────────────────────────────────────────
# Foto-Analyse (Vision API) aktivieren
NEXT_PUBLIC_VISION_ENABLED=true
